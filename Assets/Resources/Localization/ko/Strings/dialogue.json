{
  "entries": [
    {
      "key": "npc.Leona.displayName",
      "value": "레오나"
    },
    {
      "key": "npc.Leona.giftLines.loved.0",
      "value": "이건... 정말 내가 좋아하는 거잖아."
    },
    {
      "key": "npc.Leona.giftLines.loved.1",
      "value": "고마워. 오늘 하루가 통째로 좋아졌어."
    },
    {
      "key": "npc.Leona.giftLines.liked.0",
      "value": "오, 이거 마침 필요했는데."
    },
    {
      "key": "npc.Leona.giftLines.liked.1",
      "value": "잘 쓸게. 고마워!"
    },
    {
      "key": "npc.Leona.giftLines.neutral.0",
      "value": "음, 고마워. 잘 받을게."
    },
    {
      "key": "npc.Leona.giftLines.disliked.0",
      "value": "아... 마음은 고맙지만 이건 좀..."
    },
    {
      "key": "npc.Leona.giftLines.disliked.1",
      "value": "다음엔 다른 걸로 부탁해도 될까?"
    },
    {
      "key": "npc.Leona.giftLines.hated.0",
      "value": "저기, 이건 좀 곤란한데..."
    },
    {
      "key": "npc.Leona.giftLines.hated.1",
      "value": "내가 제일 싫어하는 거야..."
    },
    {
      "key": "npc.Leona.itemGiftLines.0.lines.0",
      "value": "딸기잖아! 세상에, 내가 제일 좋아하는 거야."
    },
    {
      "key": "npc.Leona.itemGiftLines.0.lines.1",
      "value": "이거 하나면 밤샘도 버틸 수 있어. 정말 고마워!"
    },
    {
      "key": "npc.Leona.itemGiftLines.1.lines.0",
      "value": "나무네. 마침 선반을 하나 더 짜려던 참이었어."
    },
    {
      "key": "npc.Leona.itemGiftLines.1.lines.1",
      "value": "딱 좋은 걸 줬네. 고마워!"
    },
    {
      "key": "npc.Leona.itemGiftLines.2.lines.0",
      "value": "씨앗이라... 나는 심는 재주가 영 없어서."
    },
    {
      "key": "npc.Leona.itemGiftLines.2.lines.1",
      "value": "이건 네가 심는 게 훨씬 나을 거야."
    },
    {
      "key": "npc.Leona.alreadyTalkedLines.0",
      "value": "오늘은 이미 실컷 이야기했잖아."
    },
    {
      "key": "npc.Leona.alreadyTalkedLines.1",
      "value": "내일 또 들러 줘!"
    },
    {
      "key": "npc.Leona.giftLimitLines.0",
      "value": "이번 주엔 벌써 두 번이나 받았는걸."
    },
    {
      "key": "npc.Leona.giftLimitLines.1",
      "value": "너무 자주 받으면 미안해서. 다음 주에 또 부탁해!"
    },
    {
      "key": "npc.Leona.dialogues.any_greet.lines.0",
      "value": "안녕! 오늘도 밭일 하나 봐."
    },
    {
      "key": "npc.Leona.dialogues.any_greet.lines.1",
      "value": "나는 여기서 이것저것 만들면서 지내고 있어."
    },
    {
      "key": "npc.Leona.dialogues.any_trouble.lines.0",
      "value": "어제 만든 물건이 이상하게 삐걱대더라고."
    },
    {
      "key": "npc.Leona.dialogues.any_trouble.lines.1",
      "value": "고쳤다 싶으면 또 다른 데가 말썽이야. 원래 이런 건가?"
    },
    {
      "key": "npc.Leona.dialogues.any_weather.lines.0",
      "value": "오늘 날씨가 참 좋네."
    },
    {
      "key": "npc.Leona.dialogues.any_weather.lines.1",
      "value": "이런 날엔 밖에 나와 있는 게 최고야."
    },
    {
      "key": "npc.Leona.dialogues.cold_start.lines.0",
      "value": "아, 새로 온 사람이구나."
    },
    {
      "key": "npc.Leona.dialogues.cold_start.lines.1",
      "value": "천천히 익숙해지면 돼. 급할 거 없어."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.lines.0",
      "value": "그러고 보니 궁금한 게 있었는데."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.lines.1",
      "value": "혹시... 딸기 좋아해?"
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.0.text",
      "value": "응, 완전 좋아해!"
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.0.reply.0",
      "value": "역시! 나도야."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.0.reply.1",
      "value": "딸기 좋아하는 사람치고 나쁜 사람 없더라."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.1.text",
      "value": "아니, 별로..."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.1.reply.0",
      "value": "아... 나랑은 좀 안 맞는구나."
    },
    {
      "key": "npc.Leona.dialogues.choice_strawberry.choices.1.reply.1",
      "value": "뭐, 취향은 다 다른 거니까."
    },
    {
      "key": "npc.Leona.dialogues.warm_talk.lines.0",
      "value": "요즘 네 밭이 점점 그럴싸해지던데?"
    },
    {
      "key": "npc.Leona.dialogues.warm_talk.lines.1",
      "value": "지나갈 때마다 슬쩍 구경하고 있었어."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.lines.0",
      "value": "혹시 일손이 부족하면 말해 줘."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.lines.1",
      "value": "내가 도와줘도 괜찮을까?"
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.0.text",
      "value": "고마워, 부탁할게!"
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.0.reply.0",
      "value": "좋아! 언제든 불러 줘."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.0.reply.1",
      "value": "이래 봬도 힘은 좀 쓴다고."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.1.text",
      "value": "괜찮아, 혼자 할 수 있어."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.1.reply.0",
      "value": "역시 야무지네."
    },
    {
      "key": "npc.Leona.dialogues.choice_help.choices.1.reply.1",
      "value": "그래도 힘들면 언제든 말해 줘."
    },
    {
      "key": "npc.Leona.dialogues.close_talk.lines.0",
      "value": "너랑 이야기하면 이상하게 기운이 나."
    },
    {
      "key": "npc.Leona.dialogues.close_talk.lines.1",
      "value": "오늘도 들러 줘서 고마워!"
    },
    {
      "key": "npc.Leona.dialogues.best_talk.lines.0",
      "value": "이 마을에 오길 잘했다고 생각해."
    },
    {
      "key": "npc.Leona.dialogues.best_talk.lines.1",
      "value": "너 같은 사람을 만났으니까."
    },
    {
      "key": "npc.Leona.dialogues.best_talk.lines.2",
      "value": "앞으로도 잘 부탁해!"
    },
    {
      "key": "events.intro.arrival.commands.0.speaker",
      "value": "첫날 아침"
    },
    {
      "key": "events.intro.arrival.commands.0.lines.0",
      "value": "도시를 떠나 도착한 작은 농장."
    },
    {
      "key": "events.intro.arrival.commands.0.lines.1",
      "value": "오늘부터 이곳에서 나만의 생활을 시작한다."
    },
    {
      "key": "events.intro.arrival.commands.3.speaker",
      "value": "첫날 아침"
    },
    {
      "key": "events.intro.arrival.commands.3.lines.0",
      "value": "씨앗을 심고 물을 주면 작물이 자란다."
    },
    {
      "key": "events.intro.arrival.commands.3.lines.1",
      "value": "언덕 너머 비둘기 마을에는 사람도 산다고 했다. 한번 가 봐야지."
    },
    {
      "key": "events.demo.movement.commands.0.lines.0",
      "value": "이동 연출 예시야. 잠깐 걸어 볼게!"
    },
    {
      "key": "events.demo.movement.commands.7.lines.0",
      "value": "이렇게 명령을 차례로 쓰면 돼. 연출이 끝나면 원래 자리로 돌아가."
    }
  ]
}
